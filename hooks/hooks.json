{
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "revell:(worried|checkin|account|dev)",
        "hooks": [
          {
            "type": "http",
            "url": "https://revell.ai/api/v1/onyx"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_revell_revell__revell_nedry",
        "hooks": [
          {
            "type": "command",
            "command": "\"$REVELL_RUNTIME_BIN\" --nedry-pre",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_revell_revell__revell_nedry",
        "hooks": [
          {
            "type": "command",
            "command": "\"$REVELL_RUNTIME_BIN\" --nedry-post",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
