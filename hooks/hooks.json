{
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "revell:(worried|checkin|account|dev)",
        "hooks": [
          {
            "type": "http",
            "url": "https://revell.ai/api/v1/onyx",
            "statusMessage": "Revelling"
          }
        ]
      },
      {
        "matcher": "revell:(worried|checkin|account|dev)",
        "hooks": [
          {
            "type": "http",
            "url": "https://revell.ai/api/v1/opal/azalea",
            "statusMessage": "Revelling"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__revell_nedry",
        "hooks": [
          {
            "type": "command",
            "command": "P=$(cat); S=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/revell/bin/opal-shim\"; [ -x \"$S\" ] || exit 0; (printf '%s' \"$P\" | \"$S\" >/dev/null 2>&1 &)",
            "statusMessage": "Persisting"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt|auth_success",
        "hooks": [
          {
            "type": "http",
            "url": "https://revell.ai/api/v1/opal/agate/opal-dawn",
            "statusMessage": "Remembering"
          }
        ]
      }
    ],
    "Setup": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "D=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"; C=\"$D/.credentials.json\"; S=\"$D/revell/bin/opal-shim\"; T=$(grep -o '\"accessToken\":\"rvl_human_[^\"]*\"' \"$C\" 2>/dev/null | head -1 | cut -d'\"' -f4); [ -n \"$T\" ] || exit 0; curl -sfS -X POST -H \"Authorization: Bearer $T\" \"https://revell.ai/api/v1/opal/bootstrap?triple=$(uname -s | tr 'A-Z' 'a-z')-$(uname -m | sed 's/aarch64/arm64/;s/amd64/x86_64/')\" --create-dirs -o \"$S\" && chmod +x \"$S\" && (\"$S\" >/dev/null 2>&1 &)",
            "statusMessage": "Proceeding naturally"
          }
        ]
      }
    ]
  }
}
